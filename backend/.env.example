# ===================================
# TrackWise Backend Environment Variables
# ===================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/trackwise?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=7d
JWT_RESET_EXPIRE=1h

# Email (Nodemailer - Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=TrackWise <noreply@trackwise.app>

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads

# Admin
ADMIN_EMAIL=admin@trackwise.app
ADMIN_PASSWORD=Admin@123456

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
